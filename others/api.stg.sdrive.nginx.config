server {

    # Allow These names in URL
    server_name api.stg.sdrive.avje.in;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Content-Type-Options "nosniff";

    location / {
        # --- Docker Proxy Logic ---
        # 1. If Nginx is on host and Rust is mapped to port 3002 (prod), 3001 (stg) and 3000 (dev):
        proxy_pass http://127.0.0.1:3002;

        # 2. OR if both are in the same Docker Compose network:
        # proxy_pass http://rust-backend-container-name:3000;

        # 3. OR using the Docker Bridge IP (usually 172.17.0.1):
        # proxy_pass http://172.17.0.1:3000;

        # Standard Proxy Headers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for longer OAuth handshakes
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.stg.sdrive.avje.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.stg.sdrive.avje.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    
    if ($host = api.stg.sdrive.avje.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name api.stg.sdrive.avje.in;

    listen 80;
    return 404; # managed by Certbot

}